# Local Docker Compose settings. Copy this file to .env if you need to
# change the defaults; this file is safe to commit, but .env is not.
MARIADB_DATABASE=revisionhub
MARIADB_USER=revisionhub_dev
MARIADB_PASSWORD=revisionhub_dev
MARIADB_ROOT_PASSWORD=local_dev_only
DB_PORT=3306
PMA_PORT=8081

# Gmail SMTP settings for outgoing email. Use a Gmail App Password, not the
# account password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM_NAME=RevisionHub
