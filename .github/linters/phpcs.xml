<?xml version="1.0" encoding="UTF-8"?>
<!-- PHP_CodeSniffer settings (CTS-155), checks PHP names follow the house style (section 8) -->
<!-- only names are checked here, PHP CS Fixer already checks the layout (PSR-12) -->
<!-- rule list: https://github.com/PHPCSStandards/PHP_CodeSniffer/wiki -->
<ruleset name="RevisionHub naming">
    <description>House style naming rules for PHP</description>

    <!-- downloaded packages aren't our code, so they're skipped -->
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!-- functions and methods are camelCase like getTestResults(), getUserID() is fine too -->
    <rule ref="Generic.NamingConventions.CamelCapsFunctionName">
        <properties>
            <property name="strict" value="false" />
        </properties>
    </rule>

    <!-- variables are camelCase like $studentNumber, private ones don't need a _ at the start -->
    <rule ref="Squiz.NamingConventions.ValidVariableName">
        <exclude name="Squiz.NamingConventions.ValidVariableName.PrivateNoUnderscore" />
    </rule>

    <!-- class names are PascalCase like StudentController, PSR-1 needs this -->
    <rule ref="Squiz.Classes.ValidClassName" />

    <!-- constants are UPPER_SNAKE_CASE like MAX_SIGN_IN_ATTEMPTS, PSR-1 needs this -->
    <rule ref="Generic.NamingConventions.UpperCaseConstantName" />
</ruleset>
