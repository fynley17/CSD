# PHPStan settings (CTS-155), finds PHP mistakes before the code runs, like using a class that doesn't exist
# pre-commit and megalinter both read this file so they always run the same check
# docs: https://phpstan.org/config-reference

parameters:
    # level 0 is the basic checks, same level pre-commit was already using
    level: 0

    # The backend paths checked by the pre-commit PHPStan hook.
    paths:
        - backend/app
        - backend/config
        - backend/public
        - backend/routes.php
        - backend/tests

    # lets PHPStan find our classes in other files, even when only one changed file is checked
    scanDirectories:
        - backend/app
        - backend/config

    # lets PHPStan find the packages from "composer install", like the one that reads .env
    bootstrapFiles:
        - backend/vendor/autoload.php

    # not our code, so never checked
    excludePaths:
        - backend/.php-cs-fixer.php
        - backend/vendor
